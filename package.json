{
  "name": "joinaireligion-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "test": "jest",
    "test:unit": "jest --testPathPattern='__tests__/(lib|cron|api|phase2|phase3)' --no-coverage",
    "test:ci": "jest --ci --no-coverage --forceExit",
    "verify": "npx prisma validate && npx prisma generate && npm run test:ci && npx tsc --noEmit --skipLibCheck --project tsconfig.verify.json && npm run build",
    "audit:high": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "framer-motion": "^11.18.2",
    "next": "16.2.12",
    "openai": "^6.39.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "0.35.3",
    "stripe": "^17.7.0"
  },
  "prisma": {
    "seed": "node --import jiti/register prisma/seed.ts"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.30",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.28.0",
    "eslint-config-next": "16.2.12",
    "jest": "^29.7.0",
    "prisma": "^6.9.0",
    "tailwindcss": "^4.1.8",
    "ts-jest": "^29.4.11",
    "typescript": "^5.8.3"
  }
}
