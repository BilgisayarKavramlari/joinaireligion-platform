generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum ActivityEventType {
  USER
  PROMPT
  AI
  BILLING
  EMAIL
  ADMIN
  SYSTEM
}

enum PracticeType {
  JOURNAL
  MEDITATION
  SYMBOL_INTERPRETATION
  GRATITUDE
  REFLECTION
}

model User {
  id                      String             @id @default(cuid())
  email                   String             @unique
  displayName             String?
  passwordHash            String?
  acceptedTermsAt         DateTime?
  preferredLocale         String             @default("en")
  preferredEmailLocale    String             @default("en")
  avatarUrl               String?
  role                    UserRole           @default(USER)
  emailVerifiedAt         DateTime?
  lastLoginAt             DateTime?
  lastActivityAt          DateTime?
  emailOptIn              Boolean            @default(false)
  emailFrequency          String             @default("weekly")
  unsubscribeToken        String?            @unique
  lastPracticeEmailSentAt DateTime?
  currentLevel            Int                @default(1)
  xpTotal                 Int                @default(0)
  daysActive              Int                @default(0)
  lastActiveDate          DateTime?
  onboardingDone          Boolean            @default(false)
  onboardingDoneAt        DateTime?
  unsubscribedAt          DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  profile                 UserProfile?
  onboarding              OnboardingAnswer[]
  queries                 AiQuery[]
  quota                   QueryQuota?
  subscription            Subscription?
  practiceLogs            UserPracticeLog[]
  journeyLevels           JourneyLevel[]
  emailLogs               EmailLog[]
  activityLogs            UserActivityLog[]
  dialogues               AiDialogue[]
  invoices                InvoiceRecord[]
  lessonQuota             LessonQuota?
  userLessons             UserLesson[]
  lessonAttempts          LessonAttempt[]
}

model EarlyAccessLead {
  id          String    @id @default(cuid())
  email       String    @unique
  source      String?
  notes       String?
  createdAt   DateTime  @default(now())
  contactedAt DateTime?
}

model UserProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  bio            String?
  intent         String?
  timezone       String?
  tradition      String?
  country        String?
  city           String?
  phone          String?
  secondaryEmail String?
  socialMedia    Json?
  avatarPath     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OnboardingAnswer {
  id          String   @id @default(cuid())
  userId      String
  questionKey String
  answer      String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, questionKey])
}

model AiQuery {
  id         String   @id @default(cuid())
  userId     String
  prompt     String
  response   String?
  tokensUsed Int?
  latencyMs  Int?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model QueryQuota {
  id          String   @id @default(cuid())
  userId      String   @unique
  periodStart DateTime
  periodEnd   DateTime
  usedQueries Int      @default(0)
  maxQueries  Int      @default(50)
  lastResetAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StripeWebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  eventType String
  status    String?
  payload   Json?
  createdAt DateTime @default(now())
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  providerCustomerId     String?
  providerPlanId         String?
  providerSubscriptionId String?
  providerPriceId        String?
  providerProductId      String?
  lastPaymentStatus      String?
  canceledAt             DateTime?
  trialEndsAt            DateTime?
  status                 SubscriptionStatus @default(TRIAL)
  currentPeriodEnd       DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Practice {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  description String
  type        PracticeType
  isPublished Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  logs        UserPracticeLog[]
}

model UserPracticeLog {
  id           String   @id @default(cuid())
  userId       String
  practiceId   String
  notes        String?
  durationMins Int?
  completedAt  DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  practice     Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
  @@index([practiceId])
}

model JourneyLevel {
  id         String   @id @default(cuid())
  userId     String
  level      Int      @default(1)
  label      String
  unlockedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, level])
}

model EmailLog {
  id            String   @id @default(cuid())
  userId        String
  template      String
  status        String
  providerMsgId String?
  metadata      Json?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserActivityLog {
  id                 String            @id @default(cuid())
  userId             String?
  anonymousSessionId String?
  eventType          ActivityEventType
  eventName          String
  path               String?
  method             String?
  metadata           Json?
  ipHash             String?
  userAgent          String?
  createdAt          DateTime          @default(now())
  user               User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([userId, createdAt])
}

model AiDialogue {
  id                String   @id @default(cuid())
  userId            String
  conversationId    String
  userPrompt        String
  assistantResponse String?
  promptCharCount   Int
  model             String?
  tokensInput       Int?
  tokensOutput      Int?
  totalTokens       Int?
  latencyMs         Int?
  safetyFlags       Json?
  checklistSnapshot Json?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([conversationId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, expiresAt])
}

model InvoiceRecord {
  id                String   @id @default(cuid())
  userId            String
  providerInvoiceId String?  @unique
  status            String
  amountCents       Int?
  currency          String?
  hostedInvoiceUrl  String?
  invoicePdfUrl     String?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Lesson {
  id                  String       @id @default(cuid())
  stepNumber          Int
  isTemplate          Boolean      @default(false)
  forUserId           String?
  levelRequired       Int          @default(1)
  title               String
  tradition           String?
  readingText         String
  practiceDescription String
  questions           Json
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  userLessons         UserLesson[]

  @@index([stepNumber, isTemplate, forUserId])
}

model UserLesson {
  id          String          @id @default(cuid())
  userId      String
  lessonId    String
  status      String          @default("PENDING")
  xpEarned    Int?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts    LessonAttempt[]

  @@unique([userId, lessonId])
  @@index([userId, status])
}

model LessonAttempt {
  id              String     @id @default(cuid())
  userLessonId    String
  userId          String
  promptText      String
  fullContextSent String
  aiRawResponse   String
  score           Int
  passed          Boolean
  feedback        String?
  tokensUsed      Int?
  latencyMs       Int?
  createdAt       DateTime   @default(now())
  userLesson      UserLesson @relation(fields: [userLessonId], references: [id], onDelete: Cascade)
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userLessonId])
}

model LessonQuota {
  id           String   @id @default(cuid())
  userId       String   @unique
  periodStart  DateTime
  periodEnd    DateTime
  usedAttempts Int      @default(0)
  maxAttempts  Int      @default(1)
  lastResetAt  DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
