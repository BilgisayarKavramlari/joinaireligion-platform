generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Existing enums ───────────────────────────────────────────────────────────

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum ActivityEventType {
  USER
  PROMPT
  AI
  BILLING
  EMAIL
  ADMIN
  SYSTEM
}

enum PracticeType {
  JOURNAL
  MEDITATION
  SYMBOL_INTERPRETATION
  GRATITUDE
  REFLECTION
}

enum CreditType {
  AI_QUERY
}

enum CreditPurchaseStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  DISPUTED
}

enum CreditLedgerSource {
  PURCHASE
  CONSUMPTION
  REVERSAL
  REFUND
  CHARGEBACK
  ADMIN_ADJUSTMENT
}

// ─── Journey automation enums ─────────────────────────────────────────────────

/// Whether the practice is delivered daily (paid) or weekly (free).
enum MessageCadence {
  DAILY
  WEEKLY
}

/// The user's subscription tier that determines practice cadence.
enum PracticeTier {
  FREE
  PAID
}

/// Lifecycle state of AI content generation for a PracticeMessage.
enum GenerationStatus {
  PENDING
  GENERATING
  GENERATED
  FAILED
}

/// Email delivery state for a PracticeMessage.
enum DeliveryStatus {
  PENDING // created but not yet queued for delivery
  QUEUED // generation complete, queued for the send cron
  SENT // handed off to email provider
  DELIVERED // provider confirmed delivery (webhook)
  FAILED // provider returned an error
  SKIPPED // excluded from this run (e.g. user unsubscribed after generation)
}

/// Execution state for an AgentRun task.
enum AgentRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum AgentArtifactStatus {
  DRAFT
  READY
  QUARANTINED
  ARCHIVED
}

enum ContentWorkflowStatus {
  DRAFT
  READY
  PUBLISHED
  QUARANTINED
  REJECTED
  UNPUBLISHED
}

enum ContentModerationOutcome {
  PASS
  QUARANTINE
  REJECT
}

enum PersonalActivityType {
  MEDITATION
  YOGA
  READING
  LESSON
  PRACTICE
  JOURNAL
  REFLECTION
  OTHER
}

enum PersonalPlanStatus {
  PLANNED
  COMPLETED
  SKIPPED
  CANCELLED
}

/// Origin of an XP award or deduction recorded in XpLedger.
enum XpSource {
  PRACTICE_RESPONSE
  LESSON_COMPLETE
  ONBOARDING_BONUS
  LEVEL_UP_BONUS
  STREAK_BONUS
  MANUAL_ADJUSTMENT
}

// ─── Core user model ──────────────────────────────────────────────────────────

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  displayName             String?
  passwordHash            String?
  acceptedTermsAt         DateTime?
  preferredLocale         String    @default("en")
  preferredEmailLocale    String    @default("en")
  avatarUrl               String?
  role                    UserRole  @default(USER)
  emailVerifiedAt         DateTime?
  lastLoginAt             DateTime?
  lastActivityAt          DateTime?
  emailOptIn              Boolean   @default(false)
  contentEmailOptIn       Boolean   @default(false)
  contentEmailOptInAt     DateTime?
  emailFrequency          String    @default("weekly")
  unsubscribeToken        String?   @unique
  lastPracticeEmailSentAt DateTime?
  currentLevel            Int       @default(1)
  xpTotal                 Int       @default(0)
  daysActive              Int       @default(0)
  lastActiveDate          DateTime?
  onboardingDone          Boolean   @default(false)
  onboardingDoneAt        DateTime?
  unsubscribedAt          DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // ── Existing relations ──────────────────────────────────────────────────────
  profile        UserProfile?
  onboarding     OnboardingAnswer[]
  queries        AiQuery[]
  quota          QueryQuota?
  subscription   Subscription?
  practiceLogs   UserPracticeLog[]
  journeyLevels  JourneyLevel[]
  emailLogs      EmailLog[]
  activityLogs   UserActivityLog[]
  dialogues      AiDialogue[]
  invoices       InvoiceRecord[]
  lessonQuota    LessonQuota?
  feedbackItems  FeedbackItem[]
  userLessons    UserLesson[]
  lessonAttempts LessonAttempt[]
  sessions       Session[]
  personalPlans  PersonalPlan[]
  privateNotes   PrivateNote[]

  // ── Journey automation relations ────────────────────────────────────────────
  practiceMessages    PracticeMessage[]
  practiceResponses   PracticeResponse[]
  xpLedger            XpLedger[]
  agentRuns           AgentRun[]
  journeyState        UserJourneyState?
  creditBalances      CreditBalance[]
  creditPurchases     CreditPurchase[]
  creditLedgerEntries CreditLedger[]
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EarlyAccessLead {
  id          String    @id @default(cuid())
  email       String    @unique
  source      String?
  notes       String?
  createdAt   DateTime  @default(now())
  contactedAt DateTime?
}

model UserProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  bio            String?
  intent         String?
  timezone       String?
  tradition      String?
  country        String?
  city           String?
  phone          String?
  secondaryEmail String?
  socialMedia    Json?
  avatarPath     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OnboardingAnswer {
  id          String   @id @default(cuid())
  userId      String
  questionKey String
  answer      String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionKey])
}

model AiQuery {
  id         String   @id @default(cuid())
  userId     String
  prompt     String
  response   String?
  tokensUsed Int?
  latencyMs  Int?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model QueryQuota {
  id          String   @id @default(cuid())
  userId      String   @unique
  periodStart DateTime
  periodEnd   DateTime
  usedQueries Int      @default(0)
  maxQueries  Int      @default(50)
  lastResetAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StripeWebhookEvent {
  id               String    @id @default(cuid())
  eventId          String    @unique
  eventType        String
  providerObjectId String?
  status           String?
  payload          Json?
  processedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([eventType, providerObjectId])
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  providerCustomerId     String?
  providerPlanId         String?
  providerSubscriptionId String?
  providerPriceId        String?
  providerProductId      String?
  planCode               String?
  providerStatus         String?
  providerEventCreatedAt Int?
  lastPaymentStatus      String?
  canceledAt             DateTime?
  trialEndsAt            DateTime?
  status                 SubscriptionStatus @default(TRIAL)
  currentPeriodEnd       DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Current spendable balance. All changes must also be recorded in CreditLedger.
model CreditBalance {
  id            String         @id @default(cuid())
  userId        String
  creditType    CreditType
  available     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries CreditLedger[]

  @@unique([userId, creditType])
  @@index([creditType, available])
}

/// Immutable snapshot of a one-time credit purchase. Sales remain feature-flagged
/// until a live Stripe package and legal copy are explicitly configured.
model CreditPurchase {
  id                        String               @id @default(cuid())
  userId                    String
  packageCode               String
  creditType                CreditType           @default(AI_QUERY)
  creditAmount              Int
  expectedAmountMinor       Int?
  paidAmountMinor           Int?
  currency                  String?
  status                    CreditPurchaseStatus @default(PENDING)
  providerCheckoutSessionId String?              @unique
  providerPaymentIntentId   String?              @unique
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  user                      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// Append-only credit movement. sourceType + sourceId + creditType makes each
/// purchase, consumption, refund, or compensation idempotent.
model CreditLedger {
  id         String             @id @default(cuid())
  userId     String
  balanceId  String
  creditType CreditType
  delta      Int
  sourceType CreditLedgerSource
  sourceId   String
  metadata   Json?
  createdAt  DateTime           @default(now())
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance    CreditBalance      @relation(fields: [balanceId], references: [id], onDelete: Restrict)

  @@unique([creditType, sourceType, sourceId])
  @@index([userId, createdAt])
  @@index([balanceId, createdAt])
}

model Practice {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  description String
  type        PracticeType
  isPublished Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  logs        UserPracticeLog[]
}

model UserPracticeLog {
  id           String   @id @default(cuid())
  userId       String
  practiceId   String
  notes        String?
  durationMins Int?
  completedAt  DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  practice     Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
  @@index([practiceId])
}

/// User-owned calendar item. Descriptive text is encrypted at application
/// level; only the schedule and bounded activity/status enums remain queryable.
model PersonalPlan {
  id                String               @id @default(cuid())
  userId            String
  activityType      PersonalActivityType
  status            PersonalPlanStatus   @default(PLANNED)
  scheduledFor      DateTime
  durationMins      Int?
  encryptedPayload  String
  encryptionVersion Int                  @default(1)
  completedAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledFor])
  @@index([userId, status, scheduledFor])
}

/// Encrypted personal journal/note. Routine administrators and background
/// agents have no relation or query path to its plaintext.
model PrivateNote {
  id                String    @id @default(cuid())
  userId            String
  encryptedPayload  String
  encryptionVersion Int       @default(1)
  aiAccessEnabled   Boolean   @default(false)
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([expiresAt])
}

model JourneyLevel {
  id         String   @id @default(cuid())
  userId     String
  level      Int      @default(1)
  label      String
  unlockedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, level])
}

model EmailLog {
  id            String   @id @default(cuid())
  userId        String
  template      String
  status        String
  dedupeKey     String?  @unique
  providerMsgId String?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserActivityLog {
  id                 String            @id @default(cuid())
  userId             String?
  anonymousSessionId String?
  eventType          ActivityEventType
  eventName          String
  path               String?
  method             String?
  metadata           Json?
  ipHash             String?
  userAgent          String?
  createdAt          DateTime          @default(now())
  user               User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([userId, createdAt])
}

model AiDialogue {
  id                String   @id @default(cuid())
  userId            String
  conversationId    String
  userPrompt        String
  assistantResponse String?
  promptCharCount   Int
  model             String?
  tokensInput       Int?
  tokensOutput      Int?
  totalTokens       Int?
  latencyMs         Int?
  safetyFlags       Json?
  checklistSnapshot Json?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([conversationId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, expiresAt])
}

model InvoiceRecord {
  id                String   @id @default(cuid())
  userId            String
  providerInvoiceId String?  @unique
  status            String
  amountCents       Int?
  currency          String?
  hostedInvoiceUrl  String?
  invoicePdfUrl     String?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Lesson {
  id                  String       @id @default(cuid())
  generationKey       String?      @unique
  stepNumber          Int
  isTemplate          Boolean      @default(false)
  forUserId           String?
  levelRequired       Int          @default(1)
  title               String
  tradition           String?
  readingText         String
  practiceDescription String
  questions           Json
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  userLessons         UserLesson[]

  @@index([stepNumber, isTemplate, forUserId])
}

model UserLesson {
  id          String          @id @default(cuid())
  userId      String
  lessonId    String
  status      String          @default("PENDING")
  xpEarned    Int?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts    LessonAttempt[]

  @@unique([userId, lessonId])
  @@index([userId, status])
}

model LessonAttempt {
  id              String     @id @default(cuid())
  userLessonId    String
  userId          String
  promptText      String
  fullContextSent String
  aiRawResponse   String
  score           Int
  passed          Boolean
  feedback        String?
  tokensUsed      Int?
  latencyMs       Int?
  createdAt       DateTime   @default(now())
  userLesson      UserLesson @relation(fields: [userLessonId], references: [id], onDelete: Cascade)
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userLessonId])
}

model LessonQuota {
  id           String   @id @default(cuid())
  userId       String   @unique
  periodStart  DateTime
  periodEnd    DateTime
  usedAttempts Int      @default(0)
  maxAttempts  Int      @default(1)
  lastResetAt  DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Journey automation models ────────────────────────────────────────────────

/// Tracks the current state of each user's automated practice journey.
/// One record per user; updated on every delivery, response, or level-up.
model UserJourneyState {
  id                      String       @id @default(cuid())
  userId                  String       @unique
  tier                    PracticeTier @default(FREE)
  practiceStreak          Int          @default(0)
  longestStreak           Int          @default(0)
  totalPracticesDelivered Int          @default(0)
  totalResponsesSubmitted Int          @default(0)
  lastPracticeDeliveredAt DateTime?
  lastResponseSubmittedAt DateTime?
  nextDailyPracticeDate   DateTime? // next scheduled daily (paid only)
  nextWeeklyPracticeDate  DateTime? // next scheduled weekly (free + paid)
  pendingLevelUp          Boolean      @default(false)
  lastLevelUpAt           DateTime?
  metadata                Json?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  user                    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Versioned prompt templates used by the agent to generate practice messages.
/// name + version form a unique key so old messages can always reference
/// the exact prompt that produced them.
model PromptVersion {
  id        String            @id @default(cuid())
  name      String // logical prompt name, e.g. "daily-practice-gen-v1"
  version   Int
  body      String // prompt template; may contain {{variable}} placeholders
  variables Json? // array of expected variable names for documentation
  isActive  Boolean           @default(false)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  messages  PracticeMessage[]

  @@unique([name, version])
  @@index([name, isActive])
}

/// One record per agent task execution (generation, scoring, delivery, etc.).
/// Multiple PracticeMessages or PracticeResponses may link to a single run
/// when the agent processes a batch.
model AgentRun {
  id                         String                      @id @default(cuid())
  agentName                  String // e.g. "practice-generator", "response-scorer"
  taskType                   String // e.g. "GENERATE_DAILY_BATCH", "SCORE_RESPONSE"
  status                     AgentRunStatus              @default(PENDING)
  userId                     String? // null for system-wide batch runs
  input                      Json? // serialised task parameters
  output                     Json? // serialised result summary
  errorMessage               String?
  startedAt                  DateTime                    @default(now())
  completedAt                DateTime?
  durationMs                 Int?
  createdAt                  DateTime                    @default(now())
  user                       User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  generatedMessages          PracticeMessage[] // messages this run created
  scoredResponses            PracticeResponse[]          @relation("ScoringRun")
  triagedFeedbackItems       FeedbackItem[]              @relation("FeedbackCurrentTriageRun")
  supportTriageDecisions     SupportTriageDecision[]     @relation("SupportTriageRun")
  supportReplies             SupportReply[]              @relation("SupportReplyAgentRun")
  ideaAssessments            IdeaAssessment[]            @relation("IdeaAssessmentRun")
  taskExecutions             TaskExecution[]             @relation("EngineeringTaskExecutionRun")
  decisionLogs               DecisionLog[]               @relation("DecisionLogRun")
  contentItems               ContentItem[]
  contentModerationDecisions ContentModerationDecision[]
  artifacts                  AgentArtifact[]

  @@index([agentName, status, createdAt])
  @@index([taskType, createdAt])
  @@index([userId, createdAt])
}

/// Locale-independent public-content candidate produced by the content agent.
/// The first live slice is draft-only; publication states are reserved for a
/// later policy-approved publishing workflow.
model ContentItem {
  id                     String                      @id @default(cuid())
  fingerprint            String                      @unique
  canonicalTopic         String
  category               String
  contentType            String
  difficulty             String?
  status                 ContentWorkflowStatus       @default(DRAFT)
  sourceSummary          Json?
  publishabilityDecision String?
  aggregateMetrics       Json?
  agentRunId             String?
  publishedAt            DateTime?
  unpublishedAt          DateTime?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  agentRun               AgentRun?                   @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  variants               ContentVariant[]
  sourceSignals          ContentSourceSignal[]
  feedbackMetrics        ContentFeedbackMetric[]
  moderationDecisions    ContentModerationDecision[]

  @@index([status, createdAt])
  @@index([category, contentType, createdAt])
  @@index([agentRunId, createdAt])
}

/// Localized representation of a content candidate.
model ContentVariant {
  id             String      @id @default(cuid())
  contentItemId  String
  locale         String
  title          String
  slug           String
  summary        String
  bodyMarkdown   String
  seoTitle       String
  seoDescription String
  faqBlocks      Json?
  qualityScore   Int?
  publishedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  contentItem    ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@unique([contentItemId, locale])
  @@unique([locale, slug])
  @@index([locale, createdAt])
}

/// Auditable internal evidence used to select a content topic.
model ContentSourceSignal {
  id            String      @id @default(cuid())
  contentItemId String
  sourceType    String
  sourceId      String?
  locale        String?
  summary       String
  weight        Int         @default(1)
  metadata      Json?
  createdAt     DateTime    @default(now())
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([contentItemId, createdAt])
  @@index([sourceType, createdAt])
}

/// Snapshot of public engagement counters. No user-level tracking is stored.
model ContentFeedbackMetric {
  id            String      @id @default(cuid())
  contentItemId String
  locale        String?
  views         Int         @default(0)
  uniqueViews   Int         @default(0)
  likes         Int         @default(0)
  dislikes      Int         @default(0)
  dwellSeconds  Int         @default(0)
  ctaClicks     Int         @default(0)
  recordedAt    DateTime    @default(now())
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([contentItemId, recordedAt])
  @@index([locale, recordedAt])
}

/// Result of the automatic quality and risk gate for a content item.
model ContentModerationDecision {
  id            String                   @id @default(cuid())
  contentItemId String
  agentRunId    String?
  outcome       ContentModerationOutcome
  riskLevel     String
  reasons       Json
  qualityScores Json?
  createdAt     DateTime                 @default(now())
  contentItem   ContentItem              @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  agentRun      AgentRun?                @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([contentItemId, createdAt])
  @@index([outcome, riskLevel, createdAt])
  @@index([agentRunId, createdAt])
}

/// Generic persisted output for draft/report-only growth agents.
model AgentArtifact {
  id           String              @id @default(cuid())
  agentName    String
  artifactType String
  fingerprint  String              @unique
  status       AgentArtifactStatus @default(DRAFT)
  locale       String?
  title        String
  summary      String?
  payload      Json
  sourceRefs   Json?
  riskLevel    String              @default("LOW")
  qualityScore Int?
  agentRunId   String?
  archivedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  agentRun     AgentRun?           @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([agentName, status, createdAt])
  @@index([artifactType, createdAt])
  @@index([agentRunId, createdAt])
}

/// One personalized practice message per user per cadence per scheduled date.
/// Generated by the agent, delivered by email, responded to by the user.
model PracticeMessage {
  id               String             @id @default(cuid())
  userId           String
  cadence          MessageCadence // DAILY (paid) or WEEKLY (free)
  tier             PracticeTier // tier at time of generation
  scheduledDate    DateTime // the calendar date this message is for (time is midnight UTC)
  subject          String? // email subject line
  bodyText         String? // plain-text body
  bodyHtml         String? // HTML body
  generationStatus GenerationStatus   @default(PENDING)
  deliveryStatus   DeliveryStatus     @default(PENDING)
  promptVersionId  String? // which prompt was used
  agentRunId       String? // which AgentRun produced this
  xpReward         Int                @default(0) // XP to award when user responds
  sentAt           DateTime?
  generatedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptVersion    PromptVersion?     @relation(fields: [promptVersionId], references: [id])
  agentRun         AgentRun?          @relation(fields: [agentRunId], references: [id])
  responses        PracticeResponse[]

  // One scheduled practice per user per cadence per day — prevents duplicates.
  @@unique([userId, cadence, scheduledDate])
  @@index([userId, scheduledDate])
  @@index([generationStatus, deliveryStatus, scheduledDate])
}

/// The user's written response to a PracticeMessage, including AI scoring (0–5)
/// and the XP awarded.  One response per user per message enforced by the
/// unique constraint.
model PracticeResponse {
  id                String          @id @default(cuid())
  userId            String
  practiceMessageId String
  responseText      String // user's submitted response
  score             Int? // 0–5, set by scoring agent after submission
  feedback          String? // AI-generated qualitative feedback
  xpEarned          Int             @default(0)
  scoringAgentRunId String? // AgentRun that scored this response
  createdAt         DateTime        @default(now())
  scoredAt          DateTime?
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceMessage   PracticeMessage @relation(fields: [practiceMessageId], references: [id], onDelete: Cascade)
  scoringAgentRun   AgentRun?       @relation("ScoringRun", fields: [scoringAgentRunId], references: [id])

  // One response per user per practice message.
  @@unique([userId, practiceMessageId])
  @@index([userId, createdAt])
  @@index([score, scoredAt])
}

/// Immutable ledger of every XP delta for a user.
/// balanceBefore + amount == balanceAfter; application code is responsible
/// for keeping this consistent with User.xpTotal.
model XpLedger {
  id            String   @id @default(cuid())
  userId        String
  amount        Int // positive (award) or negative (correction)
  source        XpSource // what caused this delta
  sourceId      String? // ID of the originating record (PracticeResponse.id, etc.)
  balanceBefore Int
  balanceAfter  Int
  notes         String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([source, sourceId])
  @@index([userId, createdAt])
}

// ─── Feedback system ──────────────────────────────────────────────────────────

enum FeedbackCategory {
  BUG
  TRANSLATION
  CONTENT
  COMPLAINT
  FEATURE_REQUEST
}

enum FeedbackStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  WONT_FIX
}

enum FeedbackAuthState {
  AUTHENTICATED
  ANONYMOUS
}

enum SupportTriageCategory {
  BUG
  ACCOUNT
  BILLING
  CONTENT
  I18N
  UX
  SPAM
  OTHER
}

enum SupportTriageSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SupportTriageRecommendedAction {
  AUTO_REPLY_DRAFT
  CREATE_CODING_TASK
  ESCALATE_TO_ADMIN
  MARK_SPAM
  MONITOR
}

enum SupportTriageStatus {
  NOT_TRIAGED
  TRIAGED
  REVIEWED
  ESCALATED
  REPLY_DRAFTED
}

enum SupportReplyAuthorType {
  ADMIN
  SUPPORT_AGENT
  SYSTEM
}

enum SupportReplyVisibility {
  ADMIN_ONLY
  USER_VISIBLE
}

enum SupportReplyStatus {
  DRAFT
  APPROVED
  SENT
  ARCHIVED
}

enum IdeaSourceType {
  ADMIN_IDEA
  SUPPORT
  QA
  GROWTH
  SOCIAL
  PRODUCT_NOTE
}

enum IdeaRecordStatus {
  NEW
  TRIAGED
  PM_REVIEWED
  CTO_REVIEWED
  ACCEPTED
  REJECTED
  ESCALATED
  BACKLOGGED
  DONE
}

enum BacklogItemStatus {
  PROPOSED
  READY_FOR_DECOMPOSITION
  READY_FOR_IMPLEMENTATION
  IN_PROGRESS
  BLOCKED
  QA_REVIEW
  READY_FOR_RELEASE
  RELEASED
  CANCELLED
}

enum BacklogPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EngineeringTaskStatus {
  DRAFT
  READY
  LOCKED
  IN_PROGRESS
  CODE_REVIEW
  QA_REVIEW
  DONE
  BLOCKED
  CANCELLED
}

enum EngineeringTaskLockStatus {
  UNLOCKED
  LOCKED
  HANDOFF_REQUIRED
  EXPIRED
}

enum TaskExecutionStatus {
  STARTED
  SUCCEEDED
  FAILED
  ABANDONED
  HANDOFF_REQUIRED
}

enum DecisionEntityType {
  IDEA
  BACKLOG_ITEM
  ENGINEERING_TASK
  TASK_EXECUTION
  RELEASE
  ADMIN_QUESTION
  FEEDBACK_ITEM
  SUPPORT_REPLY
}

enum AdminQuestionType {
  LEGAL
  SECURITY
  PAYMENT
  REPUTATION
  POLICY
  AMBIGUOUS
}

enum AdminQuestionStatus {
  OPEN
  ANSWERED
  ARCHIVED
}

enum ReleaseRecordStatus {
  PLANNED
  READY
  DEPLOYING
  RELEASED
  FAILED
  ROLLED_BACK
}

/// User-submitted feedback items (bugs, translations, content issues, etc.)
/// Visible in admin and surfaced to the autonomy system for task generation.
model FeedbackItem {
  id                     String                          @id @default(cuid())
  /// Null when submitted anonymously (not yet implemented) or user is deleted.
  userId                 String?
  category               FeedbackCategory
  status                 FeedbackStatus                  @default(OPEN)
  authState              FeedbackAuthState               @default(ANONYMOUS)
  submitterEmail         String?
  submitterLocale        String?
  pageUrl                String?
  userAgent              String?
  /// The URL or page path the user was on when submitting feedback.
  pageContext            String?
  /// Free-text message from the user.
  message                String
  /// Admin-written notes or resolution summary.
  adminNotes             String?
  triageCategory         SupportTriageCategory?
  triageSeverity         SupportTriageSeverity?
  recommendedAction      SupportTriageRecommendedAction?
  triageStatus           SupportTriageStatus             @default(NOT_TRIAGED)
  triagedAt              DateTime?
  triageRunId            String?
  latestTriageDecisionId String?
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt
  user                   User?                           @relation(fields: [userId], references: [id], onDelete: SetNull)
  triageRun              AgentRun?                       @relation("FeedbackCurrentTriageRun", fields: [triageRunId], references: [id], onDelete: SetNull)
  latestTriageDecision   SupportTriageDecision?          @relation("FeedbackLatestTriageDecision", fields: [latestTriageDecisionId], references: [id], onDelete: SetNull)
  triageDecisions        SupportTriageDecision[]         @relation("FeedbackDecisionHistory")
  supportReplies         SupportReply[]

  @@index([status, category, createdAt])
  @@index([userId, createdAt])
  @@index([authState, createdAt])
  @@index([triageStatus, triageSeverity, createdAt])
  @@index([triageRunId, triagedAt])
}

model SupportTriageDecision {
  id                String                         @id @default(cuid())
  feedbackItemId    String
  agentRunId        String
  decisionSource    String
  category          SupportTriageCategory
  severity          SupportTriageSeverity
  recommendedAction SupportTriageRecommendedAction
  reasonSummary     String?
  reasonJson        Json?
  replyDraftId      String?
  codingTaskRef     String?
  createdAt         DateTime                       @default(now())
  feedbackItem      FeedbackItem                   @relation("FeedbackDecisionHistory", fields: [feedbackItemId], references: [id], onDelete: Cascade)
  agentRun          AgentRun                       @relation("SupportTriageRun", fields: [agentRunId], references: [id], onDelete: Cascade)
  latestForFeedback FeedbackItem[]                 @relation("FeedbackLatestTriageDecision")
  replyDraft        SupportReply?                  @relation("SupportReplyDraftDecision", fields: [replyDraftId], references: [id], onDelete: SetNull)

  @@index([feedbackItemId, createdAt])
  @@index([agentRunId, createdAt])
  @@index([recommendedAction, severity, createdAt])
}

model SupportReply {
  id               String                  @id @default(cuid())
  feedbackItemId   String
  authorType       SupportReplyAuthorType
  visibility       SupportReplyVisibility  @default(ADMIN_ONLY)
  status           SupportReplyStatus      @default(DRAFT)
  body             String
  rationaleSummary String?
  agentRunId       String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  feedbackItem     FeedbackItem            @relation(fields: [feedbackItemId], references: [id], onDelete: Cascade)
  agentRun         AgentRun?               @relation("SupportReplyAgentRun", fields: [agentRunId], references: [id], onDelete: SetNull)
  triageDecisions  SupportTriageDecision[] @relation("SupportReplyDraftDecision")

  @@index([feedbackItemId, createdAt])
  @@index([status, visibility, createdAt])
  @@index([agentRunId, createdAt])
}

model IdeaRecord {
  id             String           @id @default(cuid())
  sourceType     IdeaSourceType
  sourceRef      String?
  title          String
  summary        String?
  rawPayloadJson Json?
  reporterType   String?
  status         IdeaRecordStatus @default(NEW)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  assessments    IdeaAssessment[]
  backlogItems   BacklogItem[]
  adminQuestions AdminQuestion[]

  @@index([status, createdAt])
  @@index([sourceType, createdAt])
}

model IdeaAssessment {
  id               String     @id @default(cuid())
  ideaId           String
  agentName        String
  assessmentType   String
  decision         String?
  rationaleSummary String?
  rationaleJson    Json?
  scoreValue       Int?
  createdAt        DateTime   @default(now())
  agentRunId       String?
  idea             IdeaRecord @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  agentRun         AgentRun?  @relation("IdeaAssessmentRun", fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([ideaId, createdAt])
  @@index([agentName, createdAt])
  @@index([agentRunId, createdAt])
}

model BacklogItem {
  id               String            @id @default(cuid())
  ideaId           String?
  title            String
  summary          String?
  status           BacklogItemStatus @default(PROPOSED)
  priority         BacklogPriority?
  userImpact       String?
  revenueImpact    String?
  riskLevel        String?
  targetReleaseId  String?
  ownerAgent       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  idea             IdeaRecord?       @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  targetRelease    ReleaseRecord?    @relation(fields: [targetReleaseId], references: [id], onDelete: SetNull)
  engineeringTasks EngineeringTask[]

  @@index([status, createdAt])
  @@index([priority, createdAt])
  @@index([ideaId, createdAt])
  @@index([targetReleaseId, createdAt])
}

model EngineeringTask {
  id                     String                    @id @default(cuid())
  backlogItemId          String?
  parentTaskId           String?
  title                  String
  description            String?
  phase                  String?
  status                 EngineeringTaskStatus     @default(DRAFT)
  assignedAgent          String?
  lockStatus             EngineeringTaskLockStatus @default(UNLOCKED)
  lockOwner              String?
  lockExpiresAt          DateTime?
  handoffReason          String?
  acceptanceCriteriaJson Json?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  backlogItem            BacklogItem?              @relation(fields: [backlogItemId], references: [id], onDelete: SetNull)
  parentTask             EngineeringTask?          @relation("EngineeringTaskHierarchy", fields: [parentTaskId], references: [id], onDelete: SetNull)
  childTasks             EngineeringTask[]         @relation("EngineeringTaskHierarchy")
  executions             TaskExecution[]
  adminQuestions         AdminQuestion[]

  @@index([status, createdAt])
  @@index([lockStatus, lockExpiresAt])
  @@index([assignedAgent, createdAt])
  @@index([backlogItemId, createdAt])
}

model TaskExecution {
  id                String              @id @default(cuid())
  engineeringTaskId String
  agentName         String
  agentRunId        String?
  startedAt         DateTime            @default(now())
  completedAt       DateTime?
  resultStatus      TaskExecutionStatus @default(STARTED)
  commitSha         String?
  branchName        String?
  prUrl             String?
  ciStatus          String?
  deployStatus      String?
  releaseId         String?
  notesSummary      String?
  engineeringTask   EngineeringTask     @relation(fields: [engineeringTaskId], references: [id], onDelete: Cascade)
  agentRun          AgentRun?           @relation("EngineeringTaskExecutionRun", fields: [agentRunId], references: [id], onDelete: SetNull)
  release           ReleaseRecord?      @relation(fields: [releaseId], references: [id], onDelete: SetNull)

  @@index([engineeringTaskId, startedAt])
  @@index([agentRunId, startedAt])
  @@index([releaseId, startedAt])
  @@index([resultStatus, startedAt])
}

model DecisionLog {
  id               String             @id @default(cuid())
  entityType       DecisionEntityType
  entityId         String
  decisionMaker    String
  decisionKind     String
  decision         String?
  rationaleSummary String?
  rationaleJson    Json?
  createdAt        DateTime           @default(now())
  agentRunId       String?
  agentRun         AgentRun?          @relation("DecisionLogRun", fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([decisionMaker, createdAt])
  @@index([agentRunId, createdAt])
}

model AdminQuestion {
  id                String              @id @default(cuid())
  ideaId            String?
  engineeringTaskId String?
  questionType      AdminQuestionType
  question          String
  status            AdminQuestionStatus @default(OPEN)
  answer            String?
  createdAt         DateTime            @default(now())
  answeredAt        DateTime?
  idea              IdeaRecord?         @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  engineeringTask   EngineeringTask?    @relation(fields: [engineeringTaskId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([questionType, createdAt])
  @@index([ideaId, createdAt])
  @@index([engineeringTaskId, createdAt])
}

model ReleaseRecord {
  id             String              @id @default(cuid())
  version        String
  title          String?
  status         ReleaseRecordStatus @default(PLANNED)
  commitRange    String?
  releaseNotes   String?
  deployedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  backlogItems   BacklogItem[]
  taskExecutions TaskExecution[]

  @@unique([version])
  @@index([status, createdAt])
  @@index([deployedAt])
}
