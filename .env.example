# Database
POSTGRES_PASSWORD="replace-with-a-long-random-password"
DATABASE_URL="postgresql://postgres:replace-with-the-same-password@db:5432/joinaireligion?schema=public"

# External providers (placeholders only; do NOT commit real values)
OPENAI_API_KEY="sk-placeholder"
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
RESEND_API_KEY="re_placeholder"

# Public app URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe public + prices (test mode placeholders)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"
STRIPE_PRICE_SEEKER_MONTHLY="price_test_seeker_monthly"
STRIPE_PRICE_INITIATE_MONTHLY="price_test_initiate_monthly"
CREDIT_PURCHASES_ENABLED="false"
STRIPE_PRICE_AI_CREDIT_PACK="price_test_ai_credit_pack"

# Admin/internal placeholders
ADMIN_EMAILS="admin@example.com"
INTERNAL_AGENT_API_KEY="internal_agent_key_placeholder"

EMAIL_FROM="Join AI Religion <noreply@mail.joinaireligion.com>"
EMAIL_SENDING_ENABLED="false"
PRACTICE_GENERATION_MODE="placeholder"

# 32 random bytes, base64-encoded. Required for personal plans and private notes.
# Generate once per environment and store only in the environment secret store.
PRIVATE_DATA_ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"

# Autonomous social publication (keep disabled until provider credentials are set)
SOCIAL_LISTENING_ENABLED="true"
SOCIAL_PUBLISHING_ENABLED="false"
BLUESKY_SERVICE_URL="https://bsky.social"
BLUESKY_IDENTIFIER="example.bsky.social"
BLUESKY_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# X and LinkedIn publishing (enable only after provider OAuth canaries pass)
X_BEARER_TOKEN="replace-with-app-bearer-token"
X_USER_ACCESS_TOKEN="replace-with-user-access-token"
X_API_KEY="replace-with-oauth1-api-key"
X_API_SECRET="replace-with-oauth1-api-secret"
X_ACCESS_TOKEN="replace-with-oauth1-access-token"
X_ACCESS_TOKEN_SECRET="replace-with-oauth1-access-token-secret"
X_PUBLISHING_ENABLED="false"
LINKEDIN_ACCESS_TOKEN="replace-with-member-access-token"
# Public Join AI Religion Page author; keep personal/member publishing out of scope.
LINKEDIN_AUTHOR_URN="urn:li:organization:143125933"
LINKEDIN_VERSION="YYYYMM"
LINKEDIN_PUBLISHING_ENABLED="false"

# Meta publishing (keep provider switches false until OAuth canaries pass)
META_GRAPH_VERSION="vXX.X"
META_PAGE_ID="replace-with-page-id"
META_PAGE_ACCESS_TOKEN="replace-with-page-access-token"
INSTAGRAM_USER_ID="replace-with-instagram-professional-account-id"
FACEBOOK_PUBLISHING_ENABLED="false"
INSTAGRAM_PUBLISHING_ENABLED="false"

# Threads publishing (use a long-lived Threads user token)
THREADS_APP_SECRET="replace-with-threads-app-secret"
THREADS_ACCESS_TOKEN="replace-with-long-lived-threads-user-token"
THREADS_PUBLISHING_ENABLED="false"

# Pinterest publishing (Trial Pins are private; enable only after Standard Access canary)
PINTEREST_APP_ID="replace-with-pinterest-app-id"
PINTEREST_APP_SECRET="replace-with-pinterest-app-secret"
PINTEREST_ACCESS_TOKEN="replace-with-pinterest-access-token"
PINTEREST_REFRESH_TOKEN="replace-with-pinterest-continuous-refresh-token"
PINTEREST_BOARD_ID="replace-with-locale-specific-board-id"
PINTEREST_PUBLISHING_ENABLED="false"
# Required before enabling; exact UTC ISO-8601 timestamp prevents historical package publication.
PINTEREST_ACTIVATED_AT="2026-07-29T00:00:00.000Z"

# Open and long-form distribution. Every provider stays off until its own canary passes.
DISTRIBUTION_PUBLISHING_ENABLED="false"

# Flipboard uses the public RSS feed; approval is still an external human gate.
FLIPBOARD_PUBLISHING_ENABLED="false"
FLIPBOARD_SUBMISSION_APPROVED="false"

DEV_API_KEY="replace-with-dev-api-key"
DEV_PUBLISHING_ENABLED="false"

APPLE_NEWS_CHANNEL_ID="replace-with-channel-uuid"
APPLE_NEWS_KEY_ID="replace-with-api-key-id"
APPLE_NEWS_KEY_SECRET="replace-with-base64-key-secret"
APPLE_NEWS_CHANNEL_APPROVED="false"
APPLE_NEWS_PUBLISHING_ENABLED="false"

BLOGGER_CLIENT_ID="replace-with-oauth-client-id"
BLOGGER_CLIENT_SECRET="replace-with-oauth-client-secret"
BLOGGER_REFRESH_TOKEN="replace-with-oauth-refresh-token"
BLOGGER_BLOG_ID="replace-with-blog-id"
BLOGGER_PUBLISHING_ENABLED="false"

TUMBLR_CONSUMER_KEY="replace-with-oauth1-consumer-key"
TUMBLR_CONSUMER_SECRET="replace-with-oauth1-consumer-secret"
TUMBLR_ACCESS_TOKEN="replace-with-oauth1-access-token"
TUMBLR_TOKEN_SECRET="replace-with-oauth1-token-secret"
TUMBLR_BLOG_IDENTIFIER="replace-with-blog-identifier"
TUMBLR_PUBLISHING_ENABLED="false"

HASHNODE_PAT="replace-with-personal-access-token"
HASHNODE_PUBLICATION_ID="replace-with-publication-id"
HASHNODE_PRO_CONFIRMED="false"
HASHNODE_PUBLISHING_ENABLED="false"

GHOST_ADMIN_URL="https://replace-with-ghost-site.example"
GHOST_ADMIN_API_KEY="replace-with-key-id:hex-secret"
GHOST_PUBLISHING_ENABLED="false"

LINE_CHANNEL_ACCESS_TOKEN="replace-with-channel-access-token"
LINE_PUBLISHING_ENABLED="false"

LEMMY_INSTANCE_URL="https://replace-with-lemmy-instance.example"
LEMMY_ACCESS_TOKEN="replace-with-account-token"
LEMMY_COMMUNITY_ID="replace-with-owned-or-approved-community-id"
LEMMY_COMMUNITY_APPROVED="false"
LEMMY_PUBLISHING_ENABLED="false"

MEDIAWIKI_API_URL="https://replace-with-owned-wiki.example/api.php"
MEDIAWIKI_AUTHORIZATION="Bearer replace-with-oauth-token"
MEDIAWIKI_TITLE_PREFIX="Join_AI_Religion/"
MEDIAWIKI_COMMUNITY_APPROVED="false"
MEDIAWIKI_PUBLISHING_ENABLED="false"

FANDOM_API_URL="https://replace-with-approved-community.fandom.com/api.php"
FANDOM_AUTHORIZATION="Bearer replace-with-oauth-token"
FANDOM_TITLE_PREFIX="Join_AI_Religion/"
FANDOM_COMMUNITY_APPROVED="false"
FANDOM_PUBLISHING_ENABLED="false"

# Keep private keys out of application configuration; use an external/NIP-46 signer.
NOSTR_PUBLIC_KEY="replace-with-64-character-hex-public-key"
NOSTR_RELAYS="wss://relay-one.example,wss://relay-two.example"
NOSTR_EXTERNAL_SIGNER_CONFIRMED="false"
NOSTR_PUBLISHING_ENABLED="false"
